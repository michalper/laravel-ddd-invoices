{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": [
            "src/Modules/Invoices"
        ]
    },
    "logs": {
        "text": "infection.log",
        "summary": "infection-summary.log",
        "github": true
    },
    "mutators": {
        "@default": true,
        // Diagnostics are not behaviour. Before this, most survivors were Infection
        // removing a log call outright — a change no reasonable test asserts. Log
        // *levels* are part of the observability contract and are asserted in the
        // unit tests (a draft invoice must warn; a duplicate webhook must not). Log
        // *strings* are not.
        "global-ignoreSourceCodeByRegex": [
            ".*logger->(info|warning|error|critical|debug)\\(.*",
            ".*components->(info|warn)\\(.*"
        ]
    },
    // Measured on this suite: Mutation Code Coverage 100%, Covered Code MSI 80%
    // (269 mutants: 203 killed, 48 escaped, 18 ignored, 0 not covered).
    //
    // Line coverage only proves a test executed the code; the mutation score is the
    // only evidence the assertions would notice if the behaviour changed. Gated five
    // points under the measured number so ordinary mutant-selection noise cannot
    // turn a green branch red on its own.
    //
    // What the 48 survivors are, so nobody has to re-derive it: entries inside log
    // context arrays, the retry tuning values ($tries and backoff()), and console
    // output. Those are configuration and diagnostics, not behaviour — chasing them
    // would mean asserting log copy, which makes a suite brittle without making the
    // code safer. Raise this gate as real test-quality work pushes the number up.
    // Do not lower it to make a red pull request pass.
    "minMsi": 75,
    "minCoveredMsi": 75,
    "testFramework": "phpunit",
    "testFrameworkOptions": "--testsuite=Unit,Feature"
}
