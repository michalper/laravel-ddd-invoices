APP_NAME=Laravel
APP_ENV=local
APP_KEY=base64:Vo9TJR0QSpakL5VWaduKBnh3sJBcdc92uwpVY46yluo=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8080
APP_SERVICE=app

WWWGROUP=1000
WWWUSER=1000

# Published host ports. Deliberately not 80 and 6379: a developer running this is
# very likely to already have something on both (a local Redis especially), and
# docker compose fails outright with "port is already allocated" rather than
# degrading. Change these if they clash with something of yours.
APP_PORT=8080
VITE_PORT=5173
FORWARD_REDIS_PORT=16379

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_STORE=redis

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Invoice notification delivery: "outbox" (default, durable) or "direct" (no worker needed)
INVOICE_NOTIFIER=outbox
INVOICE_RECONCILE_AFTER_MINUTES=15
